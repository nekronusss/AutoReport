server {
    listen 443 ssl;
    server_name reports.example.invalid;
    ssl_certificate /etc/letsencrypt/live/reports/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reports/privkey.pem;
    auth_basic "dqflow";
    auth_basic_user_file /etc/nginx/dqflow.htpasswd;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /metrics { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
